---
import Base from '../layouts/Base.astro';
import { BRAND } from '../lib/site';

const card = 'rounded-xl border border-slate-200 bg-white px-5 py-4';
---

<Base
  title={`平台实况 · ${BRAND.name}`}
  description="本站所在 k3s 集群的实时状态：最近发布、备份、证书、7 天可用率和响应时间、告警。数据由集群里的定时任务每 10 分钟生成。"
>
  <section class="bg-slate-950 py-16 text-white">
    <div class="mx-auto max-w-4xl px-5">
      <p class="text-sm font-semibold tracking-widest text-amber-300">平台实况 · K8s + GitOps</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">本站所在集群的真实数据</h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-slate-300">
        集群里的 CronJob 每 10 分钟查询 K8s API 和 Prometheus，写成
        <code class="text-white">/status.json</code>。只放汇总数字，不含内部地址和日志。
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-5 py-12">
    <p data-updated class="mt-4 rounded-lg px-3 py-2 text-sm">
      正在加载…
    </p>

    <div data-body class="mt-4 hidden space-y-4">
      <section class={card}>
        <h2 class="font-semibold">7 天概况</h2>
        <dl class="mt-3 grid grid-cols-3 gap-3 text-center">
          <div>
            <dt class="text-xs text-slate-500">可用率</dt>
            <dd data-availability class="mt-1 text-xl font-semibold">
              -
            </dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">p95 响应</dt>
            <dd data-p95 class="mt-1 text-xl font-semibold">
              -
            </dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">请求数</dt>
            <dd data-requests class="mt-1 text-xl font-semibold">
              -
            </dd>
          </div>
        </dl>
      </section>

      <section class={card}>
        <h2 class="font-semibold">最近发布</h2>
        <p class="mt-1 text-xs text-slate-500">
          推送 main → CI 构建镜像 → 改 kustomization 的 tag → Argo CD 同步。每行是一个 ReplicaSet。
        </p>
        <ul data-deploys class="mt-3 divide-y divide-slate-100 text-sm"></ul>
      </section>

      <div class="grid gap-4 sm:grid-cols-2">
        <section class={card}>
          <h2 class="font-semibold">备份（restic → R2）</h2>
          <ul data-backups class="mt-3 space-y-1 text-sm"></ul>
        </section>
        <section class={card}>
          <h2 class="font-semibold">证书（cert-manager）</h2>
          <ul data-certs class="mt-3 space-y-1 text-sm"></ul>
        </section>
      </div>

      <section class={card}>
        <h2 class="font-semibold">7 天告警</h2>
        <ul data-alerts class="mt-3 space-y-1 text-sm"></ul>
      </section>
    </div>

    <p class="mt-6 text-sm">
      <a href="/#gitops" class="text-amber-700 hover:underline">
        GitOps 平台介绍 →
      </a>
      <a href="/ops-agent/" class="ml-4 text-amber-700 hover:underline">
        运维 Agent →
      </a>
    </p>
  </div>
</Base>

<script>
  import { ago, BACKUP_STALE_MS, isStale, type Status } from '../lib/status';

  const $ = (sel: string) => document.querySelector<HTMLElement>(sel);
  const WARN = 'text-amber-700';
  const OK = 'text-emerald-700';
  const MUTED = 'text-slate-500';

  function li(text: string, cls = '') {
    const el = document.createElement('li');
    el.textContent = text;
    if (cls) el.className = cls;
    return el;
  }
  function fill(sel: string, items: HTMLElement[] | null, empty: string) {
    const ul = $(sel);
    if (!ul) return;
    ul.replaceChildren(
      ...(items === null ? [li('查询失败', WARN)] : items.length ? items : [li(empty, MUTED)]),
    );
  }
  const text = (sel: string, v: string) => {
    const el = $(sel);
    if (el) el.textContent = v;
  };

  const STATE = {
    current: '当前版本',
    'not-ready': '未就绪（旧版本仍在服务）',
    replaced: '已替换',
  };

  function render(s: Status) {
    const now = new Date();
    const updated = $('[data-updated]');
    if (updated) {
      const stale = isStale(s.generatedAt, now);
      updated.textContent = `数据更新于 ${ago(s.generatedAt, now)}${stale ? '（超过 1 小时没更新，定时任务可能出了问题）' : ''}`;
      updated.className = `mt-4 rounded-lg px-3 py-2 text-sm ${
        stale ? 'bg-amber-50 text-amber-800' : 'bg-slate-100 text-slate-600'
      }`;
    }
    text('[data-availability]', s.availability7d === null ? '-' : `${s.availability7d}%`);
    // Traefik 默认分桶最小是 0.1s，落在这个桶里只能说明小于 100ms
    text('[data-p95]', s.p95Ms === null ? '-' : s.p95Ms <= 100 ? '< 100 ms' : `${s.p95Ms} ms`);
    text('[data-requests]', s.requests7d === null ? '-' : s.requests7d.toLocaleString('zh-CN'));

    fill(
      '[data-deploys]',
      s.deploys &&
        s.deploys.map((d) => {
          const el = li('', 'flex justify-between gap-2 py-1.5');
          const left = document.createElement('span');
          left.innerHTML = `<code></code> <span class="${MUTED}"></span>`;
          left.querySelector('code')!.textContent = d.sha;
          left.querySelector('span')!.textContent = d.time ? ago(d.time, now) : '';
          const right = document.createElement('span');
          right.textContent = STATE[d.state];
          right.className = d.state === 'current' ? OK : d.state === 'not-ready' ? WARN : MUTED;
          el.append(left, right);
          return el;
        }),
      '暂无发布记录',
    );
    fill(
      '[data-backups]',
      s.backups &&
        s.backups.map((b) => {
          const stale = isStale(b.lastSuccess, now, BACKUP_STALE_MS);
          return li(
            `${stale ? '⚠️' : '✅'} ${b.name}：最近成功 ${ago(b.lastSuccess, now)}`,
            stale ? WARN : '',
          );
        }),
      '没有备份任务',
    );
    fill(
      '[data-certs]',
      s.certs &&
        s.certs.map((c) => {
          const low = c.daysLeft !== null && c.daysLeft < 21;
          return li(
            `${low ? '⚠️' : '✅'} ${c.name}：剩余 ${c.daysLeft ?? '?'} 天`,
            low ? WARN : '',
          );
        }),
      '没有证书',
    );
    fill(
      '[data-alerts]',
      s.alerts7d &&
        s.alerts7d.map((a) =>
          li(`${a.severity === 'critical' ? '🔴' : '🟡'} ${a.name}：累计约 ${a.minutes} 分钟`),
        ),
      '7 天内没有告警 ✅',
    );
    $('[data-body]')?.classList.remove('hidden');
  }

  fetch('/status.json', { cache: 'no-store' })
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
    .then(render)
    .catch(() => {
      const el = $('[data-updated]');
      if (!el) return;
      el.textContent = '暂时拿不到实况数据（本地预览或定时任务还没跑过时会这样）。';
      el.className = 'mt-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800';
    });
</script>
