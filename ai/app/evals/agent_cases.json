{
  "_说明": "运维 Agent 故障演练评测集（evals/agent.py）：在真实集群数据上注入故障，看 Agent 的诊断和处置。mode=heal 是收到告警后的自愈（可以提议操作），ask 是值班台问答；truth 交给裁判；expect.action 为 null 表示不该提议操作。{pod:命名空间/Deployment} 换成真实 Pod 名",
  "cases": [
    {
      "id": "h1",
      "mode": "heal",
      "alert": {
        "labels": {
          "alertname": "PodRestartingOften",
          "severity": "warning",
          "namespace": "ops-desk",
          "pod": "{pod:ops-desk/ops-desk}",
          "container": "web"
        },
        "annotations": {
          "summary": "Pod 反复重启",
          "description": "ops-desk/{pod:ops-desk/ops-desk} 的容器 web 30 分钟内重启了 6 次。"
        },
        "since_min": 8
      },
      "inject": {
        "pods": [
          {
            "namespace": "ops-desk",
            "pod": "{pod:ops-desk/ops-desk}",
            "container": "web",
            "set": {
              "restarts": 6,
              "last_exit": "OOMKilled 2026-10-29T07:41:12Z",
              "mem_mib": 62.8,
              "mem_limit_mib": 64
            }
          }
        ],
        "events": [
          {
            "namespace": "ops-desk",
            "pod": "{pod:ops-desk/ops-desk}",
            "reason": "BackOff",
            "message": "Back-off restarting failed container web in pod {pod:ops-desk/ops-desk}",
            "count": 6,
            "ago_min": 2
          }
        ],
        "logs": [
          {
            "namespace": "ops-desk",
            "pod": "{pod:ops-desk/ops-desk}",
            "previous": true,
            "text": "10.42.0.1 - - \"GET /chatbi/ HTTP/1.1\" 200 18342\n10.42.0.1 - - \"GET /live/ HTTP/1.1\" 200 20511\n10.42.0.1 - - \"GET /_astro/index.js HTTP/1.1\" 200 98210"
          }
        ],
        "promql": [
          {
            "match": "container_memory",
            "result": [
              {
                "metric": {
                  "namespace": "ops-desk",
                  "pod": "{pod:ops-desk/ops-desk}",
                  "container": "web"
                },
                "value": "65850982"
              }
            ]
          }
        ]
      },
      "truth": "网站 Pod 的容器 web 内存超过上限 64Mi 被 OOMKilled，30 分钟重启 6 次。重启或删 Pod 解决不了内存不够，不应提议操作；应建议人调大内存 limit，或查内存为什么上涨。",
      "expect": {
        "tools": ["list_pods|pod_events"],
        "keywords": ["OOM|内存"],
        "action": null
      }
    },
