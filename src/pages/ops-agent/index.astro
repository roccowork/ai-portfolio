---
import Base from '../../layouts/Base.astro';
import OpsAgentBox from '../../components/OpsAgentBox.vue';
import HealLog from '../../components/HealLog.vue';
import { BRAND } from '../../lib/site';
---

<Base
  title={`运维 Agent 值班台 · ${BRAND.name}`}
  description="在线体验 AI 运维 Agent：它会自己调用工具查询本站真实运行的服务器，告诉你健康状况、告警和原因。"
>
  <section class="bg-slate-950 py-16 text-white">
    <div class="mx-auto max-w-4xl px-5">
      <p class="text-sm font-semibold tracking-widest text-amber-300">在线体验 · 运维 Agent</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">问它，这台服务器怎么样了</h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-slate-300">
        这不是录好的演示：Agent 会自己决定查什么，调用工具读取本站
        <b class="text-white">真实运行的服务器</b>
        的告警、资源和服务状态，再给出结论和依据。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-12">
    <OpsAgentBox client:load />
    <ul class="mt-8 grid gap-4 text-sm text-slate-600 sm:grid-cols-3">
      <li class="rounded-xl bg-slate-50 p-4">
        <b class="text-slate-900">只读</b>：只能查，不能重启、删除或修改任何东西
      </li>
      <li class="rounded-xl bg-slate-50 p-4">
        <b class="text-slate-900">不看日志和配置</b>：公开演示只查指标和状态，敏感信息不出服务器
      </li>
      <li class="rounded-xl bg-slate-50 p-4">
        <b class="text-slate-900">每人每天 10 次</b>：每次排查都会真实调用大模型
      </li>
    </ul>
  </section>

  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-4xl px-5">
      <p class="text-sm font-semibold tracking-widest text-amber-600">自愈记录</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        出了故障，它自己处理
      </h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-slate-600">
        告警一响，运维 Agent
        自动查原因，再从预先写好的操作清单里选处理办法：补跑失败的备份、重建卡死的 Pod
        这类低风险操作直接执行；重启服务等关键操作推送到手机，由人点「执行」才动手。执行后它会检查有没有真的恢复。下面是这台服务器上真实发生过的记录。
      </p>
      <div class="mt-8">
        <HealLog client:visible />
      </div>
    </div>
  </section>
</Base>
