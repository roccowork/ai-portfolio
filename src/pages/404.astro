---
import Base from '../layouts/Base.astro';
import { BRAND } from '../lib/site';
---

<Base title={`页面不存在 · ${BRAND.name}`} description="页面不存在。" noindex>
  <section class="mx-auto max-w-2xl px-5 py-32 text-center">
    <p class="font-mono text-6xl font-bold text-slate-200">404</p>
    <h1 class="mt-6 text-2xl font-bold text-slate-900">页面不存在</h1>
    <p class="mt-3 text-slate-600">网站已改版，原来的页面可能已经下线。</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-slate-900 px-6 py-2.5 text-sm font-medium text-white hover:bg-slate-700"
    >
      回到首页
    </a>
  </section>
</Base>
