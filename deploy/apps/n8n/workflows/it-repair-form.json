{
  "name": "IT 报修表单 → 企业微信",
  "nodes": [
    {
      "parameters": {
        "formTitle": "IT 报修",
        "formDescription": "电脑、打印机、网络有问题就填这里，IT 会尽快联系你。",
        "formFields": {
          "values": [
            { "fieldLabel": "姓名", "requiredField": true },
            { "fieldLabel": "部门", "requiredField": true },
            {
              "fieldLabel": "问题类型",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "电脑" },
                  { "option": "打印机" },
                  { "option": "网络" },
                  { "option": "账号密码" },
                  { "option": "其他" }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "紧急程度",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "一般" },
                  { "option": "影响工作" },
                  { "option": "完全无法工作" }
                ]
              },
              "requiredField": true
            },
            { "fieldLabel": "问题描述", "fieldType": "textarea", "requiredField": true }
          ]
        },
        "options": {
          "respondWithOptions": { "values": { "formSubmittedText": "已收到，IT 会尽快联系你。" } }
        }
      },
      "name": "报修表单",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 0],
      "webhookId": "it-repair"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=替换成企业微信key",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ msgtype: 'markdown', markdown: { content: `## 🛠 新的 IT 报修\\n> 姓名：${$json['姓名']}（${$json['部门']}）\\n> 类型：${$json['问题类型']}\\n> 紧急程度：<font color=\"${$json['紧急程度'] === '一般' ? 'info' : 'warning'}\">${$json['紧急程度']}</font>\\n> 描述：${$json['问题描述']}` } }) }}",
        "options": {}
      },
      "name": "发到企业微信",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    }
  ],
  "connections": {
    "报修表单": { "main": [[{ "node": "发到企业微信", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
